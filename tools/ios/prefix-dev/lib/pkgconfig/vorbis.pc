# libvorbis pkg-config source file

prefix=${pcfiledir}/../..
exec_prefix=${prefix}/bin
libdir=${prefix}/lib
includedir=${prefix}/include

Name: vorbis
Description: vorbis is the primary Ogg Vorbis library
Version: 1.3.7
Requires.private: ogg
Conflicts:
Libs: -L${libdir} -lvorbis 
Libs.private: 
Cflags: -I${includedir}
